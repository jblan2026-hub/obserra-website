{
  "schemaVersion": "1.0.0",
  "manifestId": "obserra-academy-pollo-cinematic-v1",
  "provider": "pollo-ai",
  "integrationMode": "manual-web-subscription",
  "featureFlag": "NEXT_PUBLIC_OBSERRA_ACADEMY_CINEMATIC_MEDIA_ENABLED",
  "defaultEnabled": false,
  "securityBoundary": {
    "publicStaticAssetsOnly": true,
    "databaseReads": false,
    "databaseWrites": false,
    "learnerDataAccess": false,
    "identityDataAccess": false,
    "commerceDataAccess": false,
    "assessmentDataAccess": false,
    "certificateDataAccess": false,
    "apiRequests": false,
    "externalScripts": false,
    "externalEmbeds": false,
    "providerRuntimeConnection": false,
    "userInputAccepted": false,
    "cookiesRead": false,
    "sessionStorageRead": false,
    "localStorageRead": false,
    "databaseCredentialsRequired": false,
    "providerCredentialsRequiredInBrowser": false,
    "rule": "Academy cinematic media is delivered only as versioned public MP4 and poster files from the Obserra application. It must never connect to a database, identity provider, payment system, LMS authoring API, or external runtime script."
  },
  "brand": {
    "legalName": "OBSERRA EXECUTIVE PROTECTION & INTELLIGENCE LLC",
    "academyName": "Obserra Academy",
    "logoPath": "/brand/obserra-logo.png",
    "palette": ["#050B18", "#0B1730", "#C9A227", "#FFFFFF", "#53B7FF"],
    "personalPhotoRequired": false,
    "generatedLogoProhibited": true,
    "generatedCriticalTextProhibited": true,
    "thirdPartyLogosProhibited": true,
    "publicFigureLikenessProhibited": true
  },
  "delivery": {
    "container": "MP4",
    "videoCodec": "H.264",
    "minimumWidthPixels": 1920,
    "minimumHeightPixels": 1080,
    "frameRate": 24,
    "colorSpace": "Rec.709",
    "audioForWebsiteLoops": false,
    "posterFallbackRequired": true,
    "pauseControlRequired": true,
    "reducedMotionFallbackRequired": true,
    "viewportPlaybackRequired": true,
    "videoErrorFallbackRequired": true,
    "ownerApprovalRequired": true,
    "sha256Required": true
  },
  "assets": [
    {
      "id": "academy-learning-hero",
      "role": "academy-page-hero-loop",
      "durationSeconds": 12,
      "aspectRatio": "16:9",
      "outputPath": "/media/pollo/academy/obserra-academy-learning-hero-loop-12s.mp4",
      "posterPath": "/brand/visuals/obserra-academy.png",
      "destinationPath": "/academy",
      "status": "planned"
    },
    {
      "id": "academy-cybersecurity-foundations",
      "role": "academy-course-roadmap-ad",
      "durationSeconds": 15,
      "aspectRatio": "16:9",
      "outputPath": "/media/pollo/academy/obserra-academy-cybersecurity-foundations-15s.mp4",
      "posterPath": "/brand/visuals/obserra-cybersecurity.png",
      "destinationPath": "/academy/cybersecurity-foundations",
      "status": "planned"
    },
    {
      "id": "academy-ai-governance",
      "role": "academy-course-roadmap-ad",
      "durationSeconds": 15,
      "aspectRatio": "16:9",
      "outputPath": "/media/pollo/academy/obserra-academy-ai-governance-leadership-15s.mp4",
      "posterPath": "/brand/visuals/obserra-eios-intelligence-hero.png",
      "destinationPath": "/academy/ai-risk-ethics-governance",
      "status": "planned"
    },
    {
      "id": "academy-ciso-board-leadership",
      "role": "academy-course-roadmap-ad",
      "durationSeconds": 15,
      "aspectRatio": "16:9",
      "outputPath": "/media/pollo/academy/obserra-academy-ciso-board-leadership-15s.mp4",
      "posterPath": "/brand/visuals/obserra-core.png",
      "destinationPath": "/academy/board-communication-cybersecurity",
      "status": "planned"
    },
    {
      "id": "academy-executive-protection-intelligence",
      "role": "academy-course-roadmap-ad",
      "durationSeconds": 15,
      "aspectRatio": "16:9",
      "outputPath": "/media/pollo/academy/obserra-academy-executive-protection-intelligence-15s.mp4",
      "posterPath": "/brand/visuals/obserra-protection-intelligence.png",
      "destinationPath": "/academy/executive-protection-fundamentals",
      "status": "planned"
    }
  ],
  "releaseGate": [
    "approved-pollo-prompt",
    "official-obserra-academy-brand-review",
    "cinematic-realism-review",
    "no-generated-logo-or-critical-text",
    "no-third-party-marks-or-public-figure-likeness",
    "no-sensitive-data-in-scene-or-prompt",
    "database-isolation-test-passed",
    "static-local-path-test-passed",
    "technical-master-validation",
    "poster-fallback-validation",
    "pause-control-validation",
    "reduced-motion-validation",
    "desktop-mobile-performance-review",
    "owner-approval",
    "feature-flag-enable-after-all-active-assets-present"
  ]
}
