    "soleAcademyOwnerTitle": true,
    "additionalOwnerTitlesAllowed": false,
    "resumeTitlesMayOverrideApprovedTitle": false,
    "currentOrFormerEmployerNamesAllowed": false,
    "currentOrFormerEmployerLogosAllowed": false,
    "currentOrFormerEmployerReferencesAllowed": false,
