    "biographicalExpansionRequiresExplicitSeparateOwnerApproval": true,
    "ownerApprovedExactReferenceRequired": true,
    "faceIdentityImmutable": true,
    "voiceIdentityImmutable": true,
    "nameImmutable": true,
    "professionalIdentityImmutable": true,
    "apparentAgeImmutable": true,
    "skinToneImmutable": true,
    "facialStructureImmutable": true,
    "accentAndVocalCharacterImmutable": true,
    "ownerNameAndApprovedTitleMayAppearOnlyWithExactOwnerFaceAndVoice": true,
    "nonOwnerPresenterMayNotBeRepresentedAsDrJodyBlanchard": true,
    "identityMismatchRequiresImmediateRejection": true,
