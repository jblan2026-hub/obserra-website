      "lighting",
      "framing",
      "pose",
      "restrained natural movement",
      "official title cards",
      "official lower thirds",
      "official logo placement",
      "captions",
      "identity-preserving speech cleanup",
      "identity-preserving 4K upscaling"
    ],
    "prohibitedChanges": [
      "substitute person",
      "substitute avatar",
      "substitute voice",
      "merely similar face or voice",
      "face regeneration",
      "facial reshaping",
      "beautification",
      "skin smoothing",
      "age modification",
      "de-aging",
      "stylization",
      "voice redesign",
      "voice substitution",
      "displaying Dr. Jody Blanchard's name over a different person",
