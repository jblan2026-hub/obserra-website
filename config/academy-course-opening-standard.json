    "sole-founder-and-ceo-title-verified",
    "employer-name-and-logo-absence-verified",
    "exact-owner-face-approved",
    "exact-owner-voice-approved",
    "presenter-likeness-approved",
    "facial-motion-realism-approved",
    "pronunciation-approved",
    "4k-intro-master-verified",
