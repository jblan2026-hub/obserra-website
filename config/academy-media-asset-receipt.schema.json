{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.obserrallc.com/schemas/academy-media-asset-receipt.schema.json",
  "title": "Obserra Academy Media Asset Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "idempotencyKey",
    "courseId",
    "provider",
    "assetType",
    "status",
    "serviceAssetId",
    "mediaFile",
    "mediaSha256",
    "durationSeconds",
    "width",
    "height",
    "rightsFile",
    "qualityGates",
    "syntheticMediaDisclosure",
    "ownerApproval",
    "generatedAt",
    "downloadedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string", "minLength": 5, "maxLength": 500 },
    "idempotencyKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "courseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,120}$" },
    "provider": { "enum": ["heygen", "pollo"] },
    "assetType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,120}$" },
    "status": { "enum": ["generated", "reviewed", "accepted", "rejected"] },
    "serviceAssetId": { "type": "string", "minLength": 2, "maxLength": 500 },
    "mediaFile": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "mediaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "captionFile": { "type": ["string", "null"], "maxLength": 1000 },
    "captionSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "transcriptFile": { "type": ["string", "null"], "maxLength": 1000 },
    "transcriptSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "rightsFile": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "rightsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "width": { "type": "integer", "minimum": 720, "maximum": 7680 },
    "height": { "type": "integer", "minimum": 720, "maximum": 4320 },
    "qualityGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "reviewedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 160 },
          "passed": { "type": "boolean" },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "syntheticMediaDisclosure": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "ownerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approvedBy", "approvedAt"],
      "properties": {
        "approved": { "type": "boolean" },
        "approvedBy": { "type": "string", "minLength": 2, "maxLength": 240 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "downloadedAt": { "type": "string", "format": "date-time" }
  }
}
