    "titlePageSeconds": {
      "minimum": 3,
      "target": 5,
      "maximum": 7
    },
    "disclaimerSeconds": {
      "minimum": 8,
      "target": 10,
      "maximum": 15
    },
    "introMaster": {
      "minimumWidthPixels": 3840,
      "minimumHeightPixels": 2160,
      "aspectRatio": "16:9",
      "highestProviderQualityRequired": true,
      "upscaleWhenSourceBelow4K": true,
      "upscaleMayNotAlterIdentity": true,
      "upscaleMayNotRetouchFace": true,
      "upscaleMayNotChangeVoice": true,
      "final1080pOnlyIntroProhibitedWhen4KSupported": true
    },
    "commonLearnerDisclaimer": "Obserra EPI Academy courses provide educational and professional-development content. They do not constitute legal, regulatory, medical, investigative, or organization-specific advice; do not authorize action outside the learner's role; and do not confer professional certification, licensure, accreditation, or regulatory approval. Scenarios may be fictional or composite. Learners must follow applicable law, policy, contractual obligations, and authorized escalation procedures.",
    "syntheticMediaDisclosure": "This course may use the authorized digital likeness and voice of Dr. Jody Blanchard only when his exact owner-approved face and exact owner-approved voice are used by OBSERRA EXECUTIVE PROTECTION & INTELLIGENCE LLC.",
    "intellectualPropertyNotice": "Copyright OBSERRA EXECUTIVE PROTECTION & INTELLIGENCE LLC. All course content, media, frameworks, assessments, and learner materials are proprietary unless expressly identified otherwise.",
    "courseSpecificDisclaimerRequired": true,
    "disclaimerMustBeInTranscript": true,
    "disclaimerMustBeInCourseMetadata": true,
    "learnerAcknowledgementRequired": true
  },
