    "primaryFailureToPrevent": "Wrong-person attribution, wrong voice attribution, robotic avatar delivery, static presenter footage, generic stock montage, weak audio, repetitive scenes, low-quality template production, and unbranded course openings."
  },
  "brand": {
    "academyName": "Obserra EPI Academy",
