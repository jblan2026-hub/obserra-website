# Required only in Vercel or another secure runtime environment. Never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Academy commerce routing. Keep website-stripe until the LearnWorlds canary
# product mapping and Sandbox acceptance test pass. Then set learnworlds.
ACADEMY_COMMERCE_PROVIDER=website-stripe
LEARNWORLDS_SANDBOX_MODE=true

# LearnWorlds API credentials must be entered only in the deployment secret store.
# The school ID, public URL, custom domain, and product mappings are non-secret and
# are governed in config/learnworlds-products.json.
LEARNWORLDS_API_URL=
LEARNWORLDS_CLIENT_ID=
LEARNWORLDS_CLIENT_SECRET=
LEARNWORLDS_ACCESS_TOKEN=

# Canonical HTTPS origin of the separately routed private owner site.
# The value must contain no path, query, fragment, or embedded credentials.
OBSERRA_OWNER_SITE_URL=https://owner.obserrallc.com

# Owner identity is initialized with a one-time owner proof entered interactively.
# No additional owner identity value is stored in Vercel. Authorization is bound in
# the protected Academy database to one immutable identity subject and trusted issuer.

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
