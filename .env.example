# Required only in Vercel or another secure runtime environment. Never commit values.
# Identity remains fail closed until the runtime is explicitly enabled after the
# production Clerk instance and matching live keys have been verified.
OBSERRA_IDENTITY_RUNTIME_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Phase 1 Supabase Auth foundation. These values remain inert while the dedicated
# Supabase Auth runtime flag is false. The URL, publishable key, and exact project
# reference must identify the same approved Auth project before cutover.
OBSERRA_SUPABASE_AUTH_RUNTIME_ENABLED=false
NEXT_PUBLIC_OBSERRA_AUTH_SUPABASE_URL=https://ftkjhmtfyfkartfsnkjb.supabase.co
NEXT_PUBLIC_OBSERRA_AUTH_SUPABASE_PUBLISHABLE_KEY=
OBSERRA_AUTH_SUPABASE_PROJECT_REF=ftkjhmtfyfkartfsnkjb
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Isolated Florida Class D student-record boundary. All values are server-only
# unless a name is explicitly NEXT_PUBLIC_. Never place the Supabase service
# credential, Stripe secret, Daily key, or webhook secret in browser code.
OBSERRA_FDACS_SUPABASE_URL=
OBSERRA_FDACS_SUPABASE_PROJECT_REF=
OBSERRA_FDACS_SUPABASE_SERVICE_ROLE_KEY=
OBSERRA_FDACS_RECORD_ENCRYPTION_KEY_BASE64=
OBSERRA_FDACS_RECORD_ENCRYPTION_KEY_REFERENCE=
OBSERRA_FDACS_CLASS_D_MEDIA_PROVIDER=
OBSERRA_FDACS_DAILY_API_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Production remains fail closed until every regulatory, technical, human, and
# exact-release activation gate is genuinely complete.
OBSERRA_FDACS_PRODUCTION_ACTIVATION_AUTHORIZED=disabled
OBSERRA_FDACS_PUBLIC_ORIGIN=
OBSERRA_FDACS_DS_LICENSE_STATUS=pending
OBSERRA_FDACS_DS_LICENSE_NUMBER=
OBSERRA_FDACS_DI_LICENSE_NUMBER=
OBSERRA_FDACS_DS_BUSINESS_ENTITY_SHA256=
OBSERRA_FDACS_DI_INSTRUCTOR_SUBJECT_SHA256=

# Exact-release owner real-identity UAT. This profile is Vercel Preview only,
# expires within fourteen days, and is enforced as non-credit in PostgreSQL.
OBSERRA_FDACS_RUNTIME_ENVIRONMENT=
OBSERRA_FDACS_OWNER_UAT_AUTHORIZED=disabled
OBSERRA_FDACS_OWNER_UAT_REAL_IDENTITY_AUTHORIZED=disabled
OBSERRA_FDACS_OWNER_UAT_NON_CREDIT=
OBSERRA_FDACS_OWNER_UAT_RELEASE_SHA=
OBSERRA_FDACS_OWNER_UAT_EXPIRES_AT=
OBSERRA_FDACS_OWNER_UAT_EVIDENCE_SHA256=
OBSERRA_OWNER_EMAIL=
OBSERRA_OWNER_EMAILS=

# View-only internal owner operations preview. This distinct Preview-only profile
# reads authoritative FDACS row counts and may open a private, short-lived, owner-only
# Daily diagnostic room. It never authorizes enrollment, payment, training delivery,
# attendance or time credit, completion, certificates, LIAS, database writes, or production.
OBSERRA_FDACS_OWNER_PREVIEW_ENABLED=disabled
OBSERRA_FDACS_OWNER_PREVIEW_NON_CREDIT=
OBSERRA_FDACS_OWNER_PREVIEW_RELEASE_SHA=
OBSERRA_FDACS_OWNER_PREVIEW_EXPIRES_AT=
OBSERRA_FDACS_OWNER_PREVIEW_EVIDENCE_SHA256=

# Canonical-production internal owner review. This is separate from—and never
# enables—the regulated production activation flag. It permits only the protected
# owner-review route, real read-only FDACS counts, and a private one-owner Daily room.
# Authorization is exact-release bound, expires within fourteen days, and remains
# non-credit with all student, commerce, training, completion, certificate, and LIAS
# capabilities disabled.
OBSERRA_FDACS_PRODUCTION_OWNER_REVIEW_AUTHORIZED=disabled
OBSERRA_FDACS_PRODUCTION_OWNER_REVIEW_NON_CREDIT=
OBSERRA_FDACS_PRODUCTION_OWNER_REVIEW_RELEASE_SHA=
OBSERRA_FDACS_PRODUCTION_OWNER_REVIEW_EXPIRES_AT=
OBSERRA_FDACS_PRODUCTION_OWNER_REVIEW_EVIDENCE_SHA256=

# Regulated capabilities remain independently fail closed. Only the restricted
# owner-UAT Preview or fully authorized production runtime may enable them.
OBSERRA_FDACS_IDENTITY_VERIFICATION_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_LIVE_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_MEDIA_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_SCHEDULING_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_MAKEUP_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_RECORDED_MAKEUP_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_EXAM_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_EXAM_ADMIN_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_COMPLETION_REVIEW_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_LIAS_WORKFLOW_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_COMPLETION_DOCUMENTS_ENABLED=disabled
OBSERRA_FDACS_CLASS_D_QUALITY_ENABLED=disabled
FLORIDA_CLASS_D_PRE_ENROLLMENT_ENABLED=false

# Dedicated production Academy persistence boundary. The URL must be the real
# Academy project origin. The service-role value and email HMAC secret are
# server-only and must never use NEXT_PUBLIC_ names.
OBSERRA_ACADEMY_SUPABASE_URL=
OBSERRA_ACADEMY_SUPABASE_SERVICE_ROLE_KEY=
OBSERRA_ACADEMY_EMAIL_HASH_SECRET=

# Canonical HTTPS origin of the separately routed private owner site.
# The value must contain no path, query, fragment, or embedded credentials.
OBSERRA_OWNER_SITE_URL=https://owner.obserrallc.com

# Owner identity is initialized with a one-time owner proof entered interactively.
# No additional owner identity value is stored in Vercel. Authorization is bound in
# the protected Academy database to one immutable identity subject and trusted issuer.

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
