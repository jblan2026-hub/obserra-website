# Required only in Vercel or another secure runtime environment. Never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical HTTPS origin of the separately routed private owner site.
# The value must contain no path, query, fragment, or embedded credentials.
OBSERRA_OWNER_SITE_URL=https://owner.obserrallc.com

# Owner identity is initialized with a one-time owner proof entered interactively.
# No additional owner identity value is stored in Vercel. Authorization is bound in
# the protected Academy database to one immutable identity subject and trusted issuer.

# Application launch governance.
# APP_LAUNCH_ALLOWED_HOSTS is a comma-separated exact allow-list. Launch URLs must
# use HTTPS, TCP 443, no credentials, no query, and no fragment. Keep the Crisis
# Commander value empty until its separate SaaS runtime is production approved.
APP_LAUNCH_ALLOWED_HOSTS=
APP_LAUNCH_OBSERRA_CYBER_CRISIS_COMMANDER=

# Cyber Crisis Commander commerce remains disabled while its marketplace status is
# Coming Soon. Add real Stripe price identifiers only after the exact SaaS release,
# entitlement mapping, support model, legal terms, and production gates are approved.
STRIPE_PRICE_OBSERRA_CYBER_CRISIS_COMMANDER_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_OBSERRA_CYBER_CRISIS_COMMANDER_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_OBSERRA_CYBER_CRISIS_COMMANDER_ENTERPRISE_ANNUAL=

# Signed customer package delivery. Leave unset until an approved release exists in
# app/apps/store-catalog.json and the protected CDN/key material is operational.
APP_RELEASE_CDN_URL=
APP_RELEASE_CLOUDFRONT_KEY_PAIR_ID=
APP_RELEASE_CLOUDFRONT_PRIVATE_KEY=

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
