# Required only in Vercel or another secure runtime environment. Never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# HTTPS origin of the separately deployed private EIOS owner site.
# Example shape only: https://owner.example.com
# The value must contain no path, query, fragment, or embedded credentials.
OBSERRA_OWNER_SITE_URL=

# Owner identity, MFA, authorization, session, and private course access are enforced
# only inside the separate protected owner site. No owner email or owner role secret
# is stored in the public website environment.

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
