# Required only in Vercel or another secure runtime environment. Never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exact Clerk user ID for the single authorized company owner. Email addresses are not authorization inputs.
OBSERRA_OWNER_USER_ID=

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
