# Required only in Vercel or another secure runtime environment. Never commit values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional HTTPS origin for the separately deployed private owner site.
# Leave unset until the owner site is directly verified. Public routes fail closed when unset.
OBSERRA_OWNER_SITE_URL=

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
