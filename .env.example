# Required only in Vercel or another secure runtime environment. Never commit secret values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Academy commerce routing. Keep website-stripe until the LearnWorlds canary
# product mapping and Sandbox acceptance test pass. Then set learnworlds.
ACADEMY_COMMERCE_PROVIDER=website-stripe
LEARNWORLDS_SANDBOX_MODE=true

# LearnWorlds API endpoint is non-secret and governed in config/learnworlds-products.json.
# Only the Client ID, Client Secret, and access token belong in the deployment secret store.
LEARNWORLDS_API_URL=https://obserraepillc.learnworlds.com/admin/api/
LEARNWORLDS_CLIENT_ID=
LEARNWORLDS_CLIENT_SECRET=
LEARNWORLDS_ACCESS_TOKEN=

# HeyGen is the authorized presenter layer. Manual mode uses the annual web
# subscription and does not require HEYGEN_API_KEY. API mode is separately
# billed and must not be enabled until the owner explicitly authorizes it.
HEYGEN_INTEGRATION_MODE=manual
HEYGEN_MANUAL_SETUP_COMPLETE=false
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_TEMPLATE_16X9_ID=
HEYGEN_TEMPLATE_9X16_ID=
HEYGEN_API_KEY=

# Pollo is the authorized cinematic visual and campaign layer. Manual mode uses
# the annual web subscription. API mode is separately billed and requires an
# explicit owner decision plus a POLLO_API_KEY stored only in the secret store.
POLLO_INTEGRATION_MODE=manual
POLLO_MANUAL_SETUP_COMPLETE=false
POLLO_PRIVATE_MODE_CONFIRMED=false
POLLO_DEFAULT_MODEL_PATH=/generation/pollo/pollo-v2-0
POLLO_API_KEY=
POLLO_WEBHOOK_SECRET=

# Canonical Obserra business and owner authorization email.
# The Clerk owner account used for protected readiness endpoints must include this address.
OBSERRA_OWNER_EMAIL=info@obserrallc.com

# Canonical HTTPS origin of the separately routed private owner site.
# The value must contain no path, query, fragment, or embedded credentials.
OBSERRA_OWNER_SITE_URL=https://owner.obserrallc.com

# Optional public search-verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
